msgid "Telegram asks you to wait {} before trying again."
msgstr "Telegram просит подождать {} перед следующей попыткой."

msgid "Check the keys: api_id is a number, api_hash is 32 characters (0–9, a–f)."
msgstr "Проверьте ключи: api_id — число, api_hash — 32 символа (0–9, a–f)."

msgid "Telegram did not accept this api_id / api_hash. Check them and enter them again."
msgstr "Telegram не принял эти api_id / api_hash. Проверьте их и введите заново."

msgid "This api_id is limited by Telegram. You need another key."
msgstr "Этот api_id ограничен Telegram. Нужен другой ключ."

msgid "Invalid phone number. Enter it in international format."
msgstr "Неверный номер телефона. Введите его в международном формате."

msgid "This number is banned in Telegram."
msgstr "Этот номер заблокирован в Telegram."

msgid "Too many sign-in attempts from this number. Try again later."
msgstr "Слишком много попыток входа с этого номера. Попробуйте позже."

msgid "Invalid code."
msgstr "Неверный код."

msgid "The code has expired. Request a new one."
msgstr "Код устарел. Запросите новый."

msgid "Enter the code."
msgstr "Введите код."

msgid "Wrong password."
msgstr "Неверный пароль."

msgid "There is no account with this number. You can only sign up in the official Telegram app."
msgstr "Аккаунта с этим номером нет. Зарегистрироваться можно только в официальном приложении Telegram."

msgid "Can't reach Telegram. Check your internet and try again."
msgstr "Нет связи с Telegram. Проверьте интернет и попробуйте ещё раз."

msgid "You are not signed in."
msgstr "Вход в аккаунт не выполнен."

msgid "The session was ended on the server. Sign in again."
msgstr "Сессия завершена на сервере. Войдите заново."

msgid "This chat is not available yet. Refresh the chat list."
msgstr "Этот чат пока недоступен. Обновите список диалогов."

msgid "The message is empty."
msgstr "Сообщение пустое."

msgid "The message is longer than 4096 characters."
msgstr "Сообщение длиннее 4096 символов."

msgid "You can't write in this chat."
msgstr "В этот чат нельзя писать."

msgid "The user has blocked you."
msgstr "Пользователь вас заблокировал."

msgid "This sign-in step is no longer valid. Start signing in again."
msgstr "Этот шаг входа уже неактуален. Начните вход заново."

msgid "Oxigram is already running with this account. Close the other window (and the tray icon)."
msgstr "Oxigram уже запущен с этим аккаунтом. Закройте другое окно (и значок в трее)."

