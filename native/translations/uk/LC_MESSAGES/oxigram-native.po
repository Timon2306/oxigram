msgid "Telegram asks you to wait {} before trying again."
msgstr "Telegram просить зачекати {} перед наступною спробою."

msgid "Check the keys: api_id is a number, api_hash is 32 characters (0–9, a–f)."
msgstr "Перевірте ключі: api_id — число, api_hash — 32 символи (0–9, a–f)."

msgid "Telegram did not accept this api_id / api_hash. Check them and enter them again."
msgstr "Telegram не прийняв ці api_id / api_hash. Перевірте їх і введіть знову."

msgid "This api_id is limited by Telegram. You need another key."
msgstr "Цей api_id обмежений Telegram. Потрібен інший ключ."

msgid "Invalid phone number. Enter it in international format."
msgstr "Хибний номер телефону. Введіть його в міжнародному форматі."

msgid "This number is banned in Telegram."
msgstr "Цей номер заблоковано в Telegram."

msgid "Too many sign-in attempts from this number. Try again later."
msgstr "Забагато спроб входу з цього номера. Спробуйте пізніше."

msgid "Invalid code."
msgstr "Хибний код."

msgid "The code has expired. Request a new one."
msgstr "Код застарів. Запросіть новий."

msgid "Enter the code."
msgstr "Введіть код."

msgid "Wrong password."
msgstr "Хибний пароль."

msgid "There is no account with this number. You can only sign up in the official Telegram app."
msgstr "Облікового запису з цим номером немає. Зареєструватися можна лише в офіційному застосунку Telegram."

msgid "Can't reach Telegram. Check your internet and try again."
msgstr "Немає зв'язку з Telegram. Перевірте інтернет і спробуйте ще раз."

msgid "You are not signed in."
msgstr "Вхід в обліковий запис не виконано."

msgid "The session was ended on the server. Sign in again."
msgstr "Сеанс завершено на сервері. Увійдіть знову."

msgid "This chat is not available yet. Refresh the chat list."
msgstr "Цей чат поки недоступний. Оновіть список діалогів."

msgid "The message is empty."
msgstr "Повідомлення порожнє."

msgid "The message is longer than 4096 characters."
msgstr "Повідомлення довше за 4096 символів."

msgid "You can't write in this chat."
msgstr "У цей чат не можна писати."

msgid "The user has blocked you."
msgstr "Користувач вас заблокував."

msgid "This sign-in step is no longer valid. Start signing in again."
msgstr "Цей крок входу вже неактуальний. Почніть вхід заново."

msgid "Oxigram is already running with this account. Close the other window (and the tray icon)."
msgstr "Oxigram уже запущено з цим обліковим записом. Закрийте інше вікно (і значок у треї)."

