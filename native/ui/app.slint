// Oxigram's native window. All state lives in Rust (src/main.rs); this file
// only lays it out. Sizes and colors follow the dark theme of the WebView
// build (src/app.css, views/DialogList.svelte, views/Chat.svelte).

import { ScrollView, ListView } from "std-widgets.slint";
import "../fonts/OpenSans-Regular.ttf";
import "../fonts/OpenSans-SemiBold.ttf";

export struct MenuEntry {
    id: string,
    label: string,
    icon: string,
    danger: bool,
}

// One file in the send window.
export struct SendItem {
    name: string,
    size: string,
    thumb: image,
    has-thumb: bool,
}

export struct SaverOption {
    key: string,
    title: string,
    note: string,
    on: bool,
    // The settings page it is on: "notifications", "data" or "general"
    group: string,
    // Lines the note takes in the settings column (fixed heights)
    note-lines: int,
}

export struct DialogItem {
    title: string,
    initial: string,
    color: color,
    photo: image,
    has-photo: bool,
    preview: string,
    // "Вы: " before the preview (groups and channels)
    you: bool,
    time: string,
    unread: int,
    muted: bool,
    pinned: bool,
    online: bool,
    // 0: none, 1: sent, 2: read
    ticks: int,
    saved: bool,
    active: bool,
    // "user", "group", "channel", "saved": decides the menu's wording
    kind: string,
    archived: bool,
    // the row shows "печатает…" instead of the last message
    typing: bool,
}

// One picture inside a bubble (a whole single picture, or an album cell).
// Geometry is in logical pixels at the natural size; the bubble scales it.
export struct MediaCell {
    id: int,
    x: length,
    y: length,
    w: length,
    h: length,
    image: image,
    // 0 waiting, 1 loading, 2 ready, 3 failed, 4 waits for a click
    state: int,
    // "1:05" or "GIF", top left
    badge: string,
    play: bool,
    // Rounded corners: top-left, top-right, bottom-left, bottom-right
    tl: bool,
    tr: bool,
    bl: bool,
    br: bool,
}

// One reaction under a message.
export struct ReactionChip {
    // The message it belongs to (an album's part that carries them)
    message: int,
    // "👍", "custom:<id>", "paid", or "" for the folded custom ones
    key: string,
    // Document ID of a custom emoji, to fetch its picture
    custom: string,
    text: string,
    image: image,
    has-image: bool,
    count: int,
    mine: bool,
    // Paid and folded reactions cannot be clicked
    enabled: bool,
}

// Slint has no wrapping layout: chips come in rows of four.
export struct ReactionRow {
    chips: [ReactionChip],
}

export struct MessageItem {
    id: int,
    text: string,
    // "Фото", "Видео"… for content not drawn yet
    media: string,
    time: string,
    outgoing: bool,
    ticks: int,
    // Shown above the first message of a run in groups
    sender: string,
    sender-color: color,
    service: bool,
    // A date pill above the message when it starts a new day
    day: string,
    edited: bool,
    // Continues the run of the message above (smaller gap)
    joined: bool,
    // Last of its run: the corner next to the sender gets the "tail"
    tail: bool,
    // Has line breaks, so the time cannot sit at the end of a single line
    multiline: bool,
    // Own text message: "Изменить" in its menu
    can-edit: bool,
    // Pictures: one, or an album grid
    cells: [MediaCell],
    media-w: length,
    media-h: length,
    // Pictures without caption: the time sits on the picture
    media-only: bool,
    // No bubble behind it
    sticker: bool,
    round: bool,
    // A later message of an album: drawn by the album's first row
    hidden: bool,
    // Channel posts: every bubble as wide as the column allows
    wide: bool,
    reactions: [ReactionRow],
}

global Theme {
    out property <color> bg: #0e1621;
    out property <color> raised: #17212b;
    out property <color> input: #242f3d;
    out property <color> hover: #202b36;
    out property <color> active: #2b5278;
    out property <color> border: #0f1923;
    out property <color> text: #f5f5f5;
    out property <color> dim: #7f91a4;
    out property <color> accent: #5ea5e8;
    out property <color> accent-text: #06121f;
    out property <color> danger: #ff6b6b;
    out property <color> bubble-in: #182533;
    out property <color> bubble-out: #2b5278;
    out property <color> pill: #0e1621b8;
    out property <color> read-tick: #6ec6ff;
    out property <length> column: 820px;
}

// SVG-like icons: a path in a 24×24 box.
component Icon inherits Path {
    in property <length> size: 20px;
    in property <color> tint: Theme.dim;
    width: self.size;
    height: self.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: self.tint;
}

component StrokeIcon inherits Path {
    in property <length> size: 20px;
    in property <color> tint: Theme.dim;
    width: self.size;
    height: self.size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: self.tint;
    stroke-width: 1.8px;
    fill: transparent;
}

// One or two check marks (viewBox 18×12, as in the WebView build).
component Ticks inherits Rectangle {
    in property <int> count;
    in property <color> tint: Theme.accent;
    width: 16px;
    height: 11px;
    Path {
        width: 16px;
        height: 11px;
        viewbox-width: 18;
        viewbox-height: 12;
        stroke: root.tint;
        stroke-width: 1.6px;
        commands: root.count > 1 ? "M1.5 6.5 5 10l6.5-8M8 10l6.5-8" : "M1.5 6.5 5 10l6.5-8";
    }
}

component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint;
    in property <image> photo;
    in property <bool> has-photo;
    in property <bool> saved;
    in property <length> size: 48px;
    width: self.size;
    height: self.size;
    border-radius: self.size / 2;
    clip: true;
    // A photo comes already cut to a circle (see `circle` in main.rs).
    background: root.saved ? #4c9ffe : root.has-photo ? transparent : root.tint;
    if !root.saved && !root.has-photo: Text {
        text: root.initial;
        color: white;
        font-size: root.size * 0.4;
        font-weight: 600;
    }
    if root.saved: Icon {
        size: root.size * 0.5;
        tint: white;
        commands: "M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z";
    }
    if root.has-photo && !root.saved: Image {
        source: root.photo;
        width: root.size;
        height: root.size;
        image-fit: cover;
    }
}

// A text field drawn like the WebView's inputs.
component Field inherits Rectangle {
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> enabled: true;
    in-out property <string> text <=> input.text;
    callback accepted(string);
    public function grab-focus() {
        input.focus();
    }
    height: 40px;
    border-radius: 8px;
    background: Theme.input;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    if input.text == "": Text {
        x: 12px;
        text: root.placeholder;
        color: Theme.dim;
        font-size: 15px;
        vertical-alignment: center;
        height: parent.height;
    }
    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        color: Theme.text;
        font-size: 15px;
        enabled: root.enabled;
        input-type: root.password ? InputType.password : InputType.text;
        single-line: true;
        selection-background-color: #4a7bb7;
        accepted => {
            root.accepted(self.text);
        }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // "primary", "ghost" or "link"
    in property <string> kind: "primary";
    callback clicked();
    height: root.kind == "link" ? 24px : 40px;
    border-radius: 8px;
    background: root.kind != "primary" ? transparent : touch.has-hover && root.enabled ? #74b3ee : Theme.accent;
    border-width: root.kind == "ghost" ? 1px : 0;
    border-color: #2a3949;
    opacity: root.enabled ? 1 : 0.5;
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    Text {
        text: root.text;
        color: root.kind == "primary" ? Theme.accent-text : root.kind == "link" ? Theme.accent : Theme.text;
        font-size: 15px;
        font-weight: root.kind == "primary" ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Badge inherits Rectangle {
    in property <int> count;
    in property <bool> quiet;
    in property <bool> on-active;
    height: 22px;
    min-width: 22px;
    border-radius: 11px;
    background: root.on-active ? white : root.quiet ? Theme.dim : Theme.accent;
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        Text {
            text: root.count > 999 ? "999+" : root.count;
            color: root.on-active ? Theme.active : white;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component DialogRow inherits Rectangle {
    in property <DialogItem> item;
    callback clicked();
    callback context(length, length);
    height: 66px;
    background: root.item.active ? Theme.active : touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    property <color> soft: root.item.active ? #ffffffbf : Theme.dim;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                Avatar {
                    initial: root.item.initial;
                    tint: root.item.color;
                    photo: root.item.photo;
                    has-photo: root.item.has-photo;
                    saved: root.item.saved;
                }

                if root.item.online: Rectangle {
                    x: parent.width - 13px;
                    y: parent.height - 13px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    border-width: 2px;
                    border-color: root.item.active ? Theme.active : touch.has-hover ? Theme.hover : Theme.raised;
                    background: #4fce5d;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.item.title;
                    color: Theme.text;
                    font-weight: 600;
                    font-size: 15px;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if root.item.muted: VerticalLayout {
                    alignment: center;
                    StrokeIcon {
                        size: 14px;
                        stroke-width: 2px;
                        tint: root.soft;
                        commands: "M11 5 6 9H3v6h3l5 4V5zM16 9l5 6M21 9l-5 6";
                    }
                }
                if root.item.ticks > 0: VerticalLayout {
                    alignment: center;
                    Ticks {
                        count: root.item.ticks;
                        tint: root.item.active ? white : Theme.accent;
                    }
                }
                Text {
                    text: root.item.time;
                    color: root.soft;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: (root.item.you ? "Вы: " : "") + root.item.preview;
                    color: root.item.typing && !root.item.active ? Theme.accent : root.soft;
                    font-size: 15px;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if root.item.unread > 0: Badge {
                    count: root.item.unread;
                    quiet: root.item.muted;
                    on-active: root.item.active;
                }
                if root.item.unread == 0 && root.item.pinned: VerticalLayout {
                    alignment: center;
                    Icon {
                        size: 14px;
                        tint: root.soft;
                        commands: "M14 3l7 7-3 1-3 3 .5 4.5L14 20l-4-4-5 5v-1.5L9.5 15l-4-4 1.5-1.5L11.5 10l3-3 .5-3z";
                    }
                }
            }
        }
    }
}

component ArchiveRow inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 66px;
    background: touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: Theme.input;
                Icon {
                    size: 22px;
                    commands: "M4 4h16a1 1 0 0 1 1 1v3H3V5a1 1 0 0 1 1-1zm0 6h16v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9zm5 3v2h6v-2H9z";
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text {
                text: "Архив";
                color: Theme.text;
                font-weight: 600;
                font-size: 15px;
            }

            Text {
                text: root.label;
                color: Theme.dim;
                font-size: 15px;
            }
        }
    }
}

component Pill inherits Rectangle {
    in property <string> text;
    background: Theme.pill;
    border-radius: 13px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 3px;
        padding-bottom: 3px;
        Text {
            text: root.text;
            color: #e3eaf1;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}

// Time, "изменено" and check marks at the bottom right of a bubble.
component Meta inherits HorizontalLayout {
    in property <MessageItem> m;
    // Drawn over a picture, on a dark pill.
    in property <bool> on-media;
    alignment: end;
    spacing: 3px;
    property <color> tint: root.on-media ? white : root.m.outgoing ? #ffffff99 : Theme.dim;
    Text {
        text: (root.m.edited ? "изменено " : "") + root.m.time;
        color: root.tint;
        font-size: 11px;
        vertical-alignment: bottom;
    }

    if root.m.ticks > 0: VerticalLayout {
        alignment: end;
        Ticks {
            count: root.m.ticks;
            tint: root.m.ticks > 1 && !root.on-media ? Theme.read-tick : root.tint;
        }
    }
}

// The reactions under a message: emoji (or a custom emoji's picture) and a
// count; the own one is marked. A click sets or removes the own reaction.
component Reactions inherits VerticalLayout {
    in property <[ReactionRow]> rows;
    in property <bool> outgoing;
    callback react(int, string);
    callback want-emoji(string);
    spacing: 4px;
    for row in root.rows: HorizontalLayout {
        spacing: 4px;
        alignment: start;
        for chip in row.chips: Rectangle {
            width: chip-row.preferred-width;
            height: 26px;
            border-radius: 13px;
            background: chip.mine ? (root.outgoing ? #ffffff45 : #3a6ea5) : (root.outgoing ? #ffffff1f : #ffffff14);
            border-width: chip.mine ? 1px : 0;
            border-color: root.outgoing ? #ffffffa0 : Theme.accent;
            init => {
                if (chip.custom != "" && !chip.has-image) {
                    root.want-emoji(chip.custom);
                }
            }
            TouchArea {
                mouse-cursor: chip.enabled ? pointer : default;
                clicked => {
                    if (chip.enabled) {
                        root.react(chip.message, chip.key);
                    }
                }
            }
            chip-row := HorizontalLayout {
                padding-left: 8px;
                padding-right: 9px;
                spacing: 4px;
                if chip.has-image: VerticalLayout {
                    alignment: center;
                    Image {
                        width: 18px;
                        height: 18px;
                        source: chip.image;
                    }
                }
                if !chip.has-image: Text {
                    text: chip.text;
                    font-size: 15px;
                    vertical-alignment: center;
                }
                if chip.count > 1: Text {
                    text: chip.count;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// The pictures of a bubble. Each cell asks for its picture when created,
// so only rows on screen (plus the list's margin) download anything.
component MediaBox inherits Rectangle {
    in property <MessageItem> m;
    in property <float> k: 1;
    callback want(int);
    callback open(int);
    callback context(length, length);
    callback wheel(length);
    width: root.m.media-w * root.k;
    height: root.m.media-h * root.k;
    for c in root.m.cells: Rectangle {
        x: c.x * root.k;
        y: c.y * root.k;
        width: c.w * root.k;
        height: c.h * root.k;
        property <length> r: root.m.round ? self.width / 2 : root.m.sticker ? 0 : 12px;
        border-top-left-radius: c.tl ? self.r : 0;
        border-top-right-radius: c.tr ? self.r : 0;
        border-bottom-left-radius: c.bl ? self.r : 0;
        border-bottom-right-radius: c.br ? self.r : 0;
        // Reserved before the picture arrives, so nothing jumps.
        background: c.state == 2 || root.m.sticker ? transparent : Theme.input;
        init => {
            if (c.state == 0) {
                root.want(c.id);
            }
        }
        if c.state == 2: Image {
            width: parent.width;
            height: parent.height;
            source: c.image;
            image-fit: fill;
        }
        if c.state == 3 || c.state == 4: Text {
            width: parent.width;
            height: parent.height;
            text: c.state == 3 ? "Не удалось загрузить" : "Показать";
            color: Theme.dim;
            font-size: 12px;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if c.play: Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: #0000008c;
            Path {
                x: 15px;
                y: 13px;
                width: 18px;
                height: 18px;
                viewbox-width: 24;
                viewbox-height: 24;
                fill: white;
                commands: "M6 3.5l14 8.5-14 8.5z";
            }
        }
        if c.badge != "": Rectangle {
            x: 8px;
            y: 8px;
            width: badge.preferred-width + 14px;
            height: 18px;
            border-radius: 9px;
            background: #00000080;
            badge := Text {
                x: 7px;
                width: self.preferred-width;
                height: parent.height;
                text: c.badge;
                color: white;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        TouchArea {
            mouse-cursor: root.m.sticker ? default : pointer;
            clicked => {
                root.open(c.id);
            }
            pointer-event(event) => {
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                    root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            scroll-event(event) => {
                root.wheel(event.delta-y);
                accept
            }
        }
    }
}

component MessageView inherits VerticalLayout {
    in property <MessageItem> m;
    in property <length> max-bubble;
    callback context(length, length);
    callback wheel(length);
    // Text is drawn with the light Text element; only a message picked with
    // "Выделить текст" in its menu becomes a selectable TextInput. A
    // TextInput per bubble made rows several times costlier to create while
    // scrolling (stalls up to 165 ms, against ~20 ms with Text).
    in property <bool> selecting;
    // A left click on another bubble ends the selection mode.
    callback stop-select();
    callback want-picture(int);
    callback open-picture(int);
    callback react(int, string);
    callback want-emoji(string);
    padding-top: root.m.hidden || root.m.day != "" ? 0 : root.m.joined ? 2px : 8px;
    if root.m.day != "": HorizontalLayout {
        alignment: center;
        padding-top: 8px;
        padding-bottom: 8px;
        Pill {
            text: root.m.day;
        }
    }
    if root.m.service: HorizontalLayout {
        alignment: center;
        Pill {
            text: root.m.text;
            max-width: root.max-bubble;
        }
    }
    if !root.m.service && !root.m.hidden: HorizontalLayout {
        alignment: root.m.outgoing ? end : start;
        bubble := Rectangle {
            property <bool> has-media: root.m.media-w > 0;
            // Stickers and round videos have no bubble at all.
            property <bool> bare: root.m.sticker || root.m.round;
            property <length> mpad: self.bare ? 0 : root.m.media-only ? 3px : 4px;
            // Channel posts all take the full width, pictures scaled to it.
            property <bool> wide: root.m.wide && !self.bare;
            // Otherwise a bubble with pictures is exactly as wide as the
            // pictures; a narrow window scales them down.
            property <length> mw: self.wide ? root.max-bubble - 2 * self.mpad : min(root.m.media-w, root.max-bubble - 2 * self.mpad);
            property <float> k: self.has-media ? self.mw / root.m.media-w : 1;
            property <length> pad-x: self.has-media ? self.mpad + 7px : 11px;
            property <length> mh: root.m.media-h * self.k;
            // The pictures are placed by hand above the text: a wrapped text
            // inside a nested layout got a wrong height and spilled out.
            property <length> media-top: root.m.sender != "" ? 6px + sender.preferred-height + 4px : self.mpad;
            // Room for text inside the widest bubble.
            property <length> max-text: (self.has-media ? self.mw + 2 * self.mpad : root.max-bubble) - 2 * self.pad-x;
            property <length> meta-w: meta-probe.preferred-width + 10px;
            // A short single line keeps the time on the same line, as Telegram does.
            property <bool> inline: !root.m.multiline && root.m.text != "" && measure.preferred-width + self.meta-w <= self.max-text;
            property <length> content: max(self.inline ? measure.preferred-width + self.meta-w : min(measure.preferred-width, self.max-text), meta-probe.preferred-width, sender.preferred-width, kind.preferred-width, react-probe.preferred-width);
            width: self.has-media ? self.mw + 2 * self.mpad : self.wide ? root.max-bubble : min(root.max-bubble, self.content + 2 * self.pad-x + 1px);
            background: self.bare ? transparent : root.m.outgoing ? Theme.bubble-out : Theme.bubble-in;
            border-top-left-radius: 18px;
            border-top-right-radius: 18px;
            border-bottom-left-radius: root.m.tail && !root.m.outgoing ? 6px : 18px;
            border-bottom-right-radius: root.m.tail && root.m.outgoing ? 6px : 18px;
            measure := Text {
                text: root.m.text;
                font-size: 15.5px;
                visible: false;
            }

            meta-probe := Meta {
                m: root.m;
                visible: false;
            }

            // Widths of the optional lines, measured outside the layout.
            sender := Text {
                text: root.m.sender;
                font-size: 13px;
                font-weight: 600;
                visible: false;
            }

            kind := Text {
                text: root.m.media;
                font-size: 14px;
                visible: false;
            }

            react-probe := Reactions {
                rows: root.m.reactions;
                visible: false;
            }

            height: content.preferred-height;
            // Below the text: a right click on it is ignored by the text input and lands here.
            TouchArea {
                width: parent.width;
                height: parent.height;
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down && !root.selecting) {
                        root.stop-select();
                    }
                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                        root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
                scroll-event(event) => {
                    root.wheel(event.delta-y);
                    accept
                }
            }

            if bubble.has-media && root.m.sender != "": Text {
                x: bubble.pad-x;
                y: 6px;
                width: parent.width - 2 * bubble.pad-x;
                text: root.m.sender;
                color: root.m.sender-color;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            if bubble.has-media: MediaBox {
                x: bubble.mpad;
                y: bubble.media-top;
                m: root.m;
                k: bubble.k;
                want(id) => {
                    root.want-picture(id);
                }
                open(id) => {
                    root.open-picture(id);
                }
                context(x, y) => {
                    root.context(x, y);
                }
                wheel(dy) => {
                    root.wheel(dy);
                }
            }

            content := VerticalLayout {
                width: parent.width;
                padding-left: bubble.pad-x;
                padding-right: bubble.pad-x;
                // Room for the pictures placed above.
                padding-top: !bubble.has-media ? 6px : root.m.media-only ? bubble.media-top + bubble.mh : bubble.media-top + bubble.mh + 5px;
                padding-bottom: root.m.media-only ? bubble.mpad : 6px;
                spacing: 3px;
                // Conditional, not hidden: a hidden child still gets the
                // layout's spacing and leaves a gap above the text.
                if root.m.sender != "" && !bubble.has-media: Text {
                    text: root.m.sender;
                    color: root.m.sender-color;
                    font-size: 13px;
                    font-weight: 600;
                }
                if root.m.media != "": Text {
                    text: root.m.media;
                    color: root.m.outgoing ? #a9d4ff : Theme.accent;
                    font-size: 14px;
                }

                if bubble.inline: HorizontalLayout {
                    spacing: 10px;
                    if root.selecting: TextInput {
                        text: root.m.text;
                        read-only: true;
                        single-line: true;
                        color: Theme.text;
                        font-size: 15.5px;
                        selection-background-color: #4a7bb7;
                        selection-foreground-color: white;
                        init => {
                            self.focus();
                        }
                    }
                    if !root.selecting: Text {
                        text: root.m.text;
                        color: Theme.text;
                        font-size: 15.5px;
                    }

                    VerticalLayout {
                        alignment: end;
                        padding-bottom: 1px;
                        Meta {
                            m: root.m;
                        }
                    }
                }
                if !bubble.inline && root.m.text != "" && root.selecting: TextInput {
                    text: root.m.text;
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    color: Theme.text;
                    font-size: 15.5px;
                    selection-background-color: #4a7bb7;
                    selection-foreground-color: white;
                    init => {
                        self.focus();
                    }
                }
                if !bubble.inline && root.m.text != "" && !root.selecting: Text {
                    text: root.m.text;
                    wrap: word-wrap;
                    color: Theme.text;
                    font-size: 15.5px;
                }
                if root.m.reactions.length > 0: Reactions {
                    rows: root.m.reactions;
                    outgoing: root.m.outgoing;
                    react(message, key) => {
                        root.react(message, key);
                    }
                    want-emoji(id) => {
                        root.want-emoji(id);
                    }
                }
                if !bubble.inline && !root.m.media-only: Meta {
                    m: root.m;
                }
            }

            // Pictures without a caption: the time sits on the picture.
            if root.m.media-only: Rectangle {
                x: parent.width - bubble.mpad - self.width - 6px;
                y: parent.height - bubble.mpad - self.height - 6px;
                width: on-pic.preferred-width + 14px;
                height: 20px;
                border-radius: 10px;
                background: #00000073;
                on-pic := Meta {
                    x: 7px;
                    width: self.preferred-width;
                    height: parent.height;
                    m: root.m;
                    on-media: true;
                    alignment: center;
                }
            }
        }
    }
}

component LoginCard inherits Rectangle {
    in property <string> stage;
    in property <string> phone;
    in property <string> hint;
    in property <string> error;
    in property <bool> busy;
    in property <bool> keys-rejected;
    callback save-keys(string, string);
    callback request-code(string);
    callback submit-code(string);
    callback submit-password(string);
    callback back-to-phone();
    callback change-keys();
    callback open-proxy();
    background: Theme.bg;

    VerticalLayout {
        alignment: center;
        padding: 24px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(380px, root.width - 48px);
                background: Theme.raised;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    Text {
                        text: root.stage == "keys" ? "Ключи Telegram API" : root.stage == "phone" ? "Вход в Telegram" : root.stage == "code" ? "Код подтверждения" : root.stage == "password" ? "Облачный пароль" : "Oxigram";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 600;
                    }

                    if root.stage == "loading": Text {
                        text: "Подключение…";
                        color: Theme.dim;
                        font-size: 15px;
                    }

                    if root.stage == "keys": VerticalLayout {
                        spacing: 14px;
                        Text {
                            text: "Oxigram работает только с вашими ключами. Получите api_id и api_hash на my.telegram.org → API development tools.";
                            color: Theme.dim;
                            wrap: word-wrap;
                            font-size: 14px;
                        }

                        VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: "api_id";
                                color: Theme.dim;
                                font-size: 13px;
                            }

                            api-id := Field {
                                placeholder: "1234567";
                                enabled: !root.busy;
                                init => {
                                    self.grab-focus();
                                }
                                accepted => {
                                    api-hash.grab-focus();
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: "api_hash";
                                color: Theme.dim;
                                font-size: 13px;
                            }

                            api-hash := Field {
                                placeholder: "32 символа";
                                enabled: !root.busy;
                                accepted => {
                                    root.save-keys(api-id.text, api-hash.text);
                                }
                            }
                        }

                        Button {
                            text: root.busy ? "Сохранение…" : "Сохранить";
                            enabled: !root.busy;
                            clicked => {
                                root.save-keys(api-id.text, api-hash.text);
                            }
                        }

                        // Keys are checked by connecting: where Telegram is
                        // blocked, the proxy has to come first.
                        Button {
                            kind: "link";
                            text: "Настроить прокси";
                            enabled: !root.busy;
                            clicked => {
                                root.open-proxy();
                            }
                        }
                    }

                    if root.stage == "phone": VerticalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: "Номер телефона в международном формате";
                                color: Theme.dim;
                                font-size: 13px;
                            }

                            phone-field := Field {
                                placeholder: "+7 900 000 00 00";
                                enabled: !root.busy;
                                init => {
                                    self.grab-focus();
                                }
                                accepted => {
                                    root.request-code(self.text);
                                }
                            }
                        }

                        Button {
                            text: root.busy ? "Отправка…" : "Получить код";
                            enabled: !root.busy;
                            clicked => {
                                root.request-code(phone-field.text);
                            }
                        }

                        Button {
                            kind: "link";
                            text: "Другие ключи API";
                            enabled: !root.busy;
                            clicked => {
                                root.change-keys();
                            }
                        }

                        Button {
                            kind: "link";
                            text: "Настроить прокси";
                            enabled: !root.busy;
                            clicked => {
                                root.open-proxy();
                            }
                        }
                    }

                    if root.stage == "code": VerticalLayout {
                        spacing: 14px;
                        Text {
                            text: "Код отправлен на " + root.phone + " — в приложение Telegram на другом устройстве или по SMS.";
                            color: Theme.dim;
                            wrap: word-wrap;
                            font-size: 14px;
                        }

                        VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: "Код";
                                color: Theme.dim;
                                font-size: 13px;
                            }

                            code-field := Field {
                                placeholder: "12345";
                                enabled: !root.busy;
                                init => {
                                    self.grab-focus();
                                }
                                accepted => {
                                    root.submit-code(self.text);
                                }
                            }
                        }

                        Button {
                            text: root.busy ? "Проверка…" : "Войти";
                            enabled: !root.busy;
                            clicked => {
                                root.submit-code(code-field.text);
                            }
                        }

                        Button {
                            kind: "link";
                            text: "Другой номер";
                            enabled: !root.busy;
                            clicked => {
                                root.back-to-phone();
                            }
                        }
                    }

                    if root.stage == "password": VerticalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: root.hint != "" ? "Пароль (подсказка: " + root.hint + ")" : "Пароль двухэтапной проверки";
                                color: Theme.dim;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            password-field := Field {
                                password: true;
                                enabled: !root.busy;
                                init => {
                                    self.grab-focus();
                                }
                                accepted => {
                                    root.submit-password(self.text);
                                }
                            }
                        }

                        Button {
                            text: root.busy ? "Проверка…" : "Войти";
                            enabled: !root.busy;
                            clicked => {
                                root.submit-password(password-field.text);
                            }
                        }

                        Button {
                            kind: "link";
                            text: "Начать заново";
                            enabled: !root.busy;
                            clicked => {
                                root.back-to-phone();
                            }
                        }
                    }

                    if root.error != "": Text {
                        text: root.error;
                        color: Theme.danger;
                        wrap: word-wrap;
                        font-size: 14px;
                    }
                    if root.keys-rejected: Button {
                        kind: "ghost";
                        text: "Ввести ключи заново";
                        clicked => {
                            root.change-keys();
                        }
                    }
                }
            }
        }
    }
}

component DrawerItem inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 44px;
    background: touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    Text {
        x: 18px;
        text: root.text;
        color: Theme.text;
        font-size: 15px;
        vertical-alignment: center;
        height: parent.height;
    }
}

component DangerButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 40px;
    min-width: 110px;
    border-radius: 8px;
    background: touch.has-hover ? #ff8585 : Theme.danger;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            color: #1a0505;
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// A dialog box over a dimmed window; a click outside closes it.
component Modal inherits Rectangle {
    in property <string> title;
    in property <length> box-width: 420px;
    callback close();
    background: #00000073;
    // Swallows clicks and the wheel: neither may reach the window below.
    TouchArea {
        clicked => {
            root.close();
        }
        scroll-event(event) => {
            accept
        }
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(root.box-width, parent.width - 32px);
        // Never taller than the window: a long dialog scrolls inside.
        height: min(body.preferred-height, parent.height - 32px);
        border-radius: 12px;
        background: Theme.raised;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000080;
        clip: true;
        TouchArea { }
        // Scrolled by hand: a wheel over the dialog never reached Slint's own
        // scrolling here. The touch area under the content takes the wheel
        // wherever the content itself does not (text, gaps, rows).
        flick := Flickable {
            width: parent.width;
            height: parent.height;
            content-height: body.preferred-height;
            interactive: false;
            TouchArea {
                width: parent.width;
                height: body.preferred-height;
                scroll-event(event) => {
                    flick.content-y = max(min(0px, flick.height - body.preferred-height), min(0px, flick.content-y + event.delta-y));
                    accept
                }
            }
            body := VerticalLayout {
                width: parent.width;
                padding: 22px;
                spacing: 16px;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 600;
                }

                @children
            }
        }
    }
}


// ---- Settings panel (like Telegram Web: a column that replaces the chat list)

// One line of a settings card: a coloured icon tile, a label, a value.
component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> tint;
    in property <string> icon;
    in property <bool> danger;
    callback clicked();
    height: 48px;
    border-radius: 10px;
    background: row-touch.has-hover ? Theme.hover : transparent;
    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                background: root.tint;
                StrokeIcon {
                    x: 5px;
                    y: 5px;
                    tint: white;
                    stroke-width: 2px;
                    commands: root.icon;
                }
            }
        }

        Text {
            text: root.label;
            color: root.danger ? Theme.danger : Theme.text;
            font-size: 15px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.value != "": Text {
            text: root.value;
            color: Theme.dim;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
            max-width: 130px;
        }
    }
}

// A line of the profile card: the value and what it is.
component InfoRow inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <color> tint;
    in property <string> icon;
    height: 52px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                background: root.tint;
                StrokeIcon {
                    x: 5px;
                    y: 5px;
                    tint: white;
                    stroke-width: 2px;
                    commands: root.icon;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.value;
                color: Theme.text;
                font-size: 15px;
                overflow: elide;
            }

            Text {
                text: root.label;
                color: Theme.dim;
                font-size: 12px;
            }
        }
    }
}

// A switch with a title and a note. Heights are fixed (the note's line count
// comes from Rust): Slint mis-measures wrapped text in nested layouts.
component ToggleRow inherits Rectangle {
    in property <SaverOption> option;
    callback toggle(string);
    height: 12px + 21px + 2px + root.option.note-lines * 18px + 12px;
    border-radius: 10px;
    background: toggle-touch.has-hover ? Theme.hover : transparent;
    toggle-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggle(root.option.key);
        }
    }
    HorizontalLayout {
        padding: 12px;
        spacing: 14px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.option.title;
                color: Theme.text;
                font-size: 15px;
                overflow: elide;
                height: 21px;
            }

            Text {
                text: root.option.note;
                color: Theme.dim;
                font-size: 13px;
                wrap: word-wrap;
                height: root.option.note-lines * 18px;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 18px;
                border-radius: 9px;
                background: root.option.on ? Theme.accent : Theme.input;
                Rectangle {
                    x: root.option.on ? parent.width - self.width - 3px : 3px;
                    y: 3px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: root.option.on ? white : Theme.dim;
                }
            }
        }
    }
}

component SettingsCard inherits Rectangle {
    background: Theme.raised;
    border-radius: 14px;
    height: card-body.preferred-height;
    card-body := VerticalLayout {
        padding: 4px;
        @children
    }
}

component SettingsPanel inherits Rectangle {
    in-out property <string> page: "main";
    in property <string> name;
    in property <string> phone;
    in property <string> username;
    in property <string> initial;
    in property <color> tint;
    in property <image> photo;
    in property <bool> has-photo;
    in property <[SaverOption]> options;
    in property <string> cache-text;
    in property <string> version;
    in property <string> proxy-summary;
    callback close();
    callback toggle(string);
    callback clear-cache();
    callback sign-out();
    callback open-proxy();
    property <bool> muted: false;
    background: Theme.bg;
    // Swallows clicks and the wheel meant for the list below.
    TouchArea {
        scroll-event(event) => {
            accept
        }
    }
    // The page scrolls by hand (see Modal); a new page starts at the top.
    changed page => {
        flick.content-y = 0;
    }

    // Header
    Rectangle {
        y: 0;
        height: 56px;
        background: Theme.raised;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 12px;
            spacing: 8px;
            Rectangle {
                width: 40px;
                height: 40px;
                y: 8px;
                border-radius: 20px;
                background: back-touch.has-hover ? Theme.hover : transparent;
                back-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.page == "main") {
                            root.close();
                        } else {
                            root.page = "main";
                        }
                    }
                }
                StrokeIcon {
                    x: 10px;
                    y: 10px;
                    tint: Theme.text;
                    stroke-width: 2px;
                    commands: "M15 5l-7 7 7 7";
                }
            }

            Text {
                text: root.page == "notifications" ? "Уведомления" : root.page == "data" ? "Данные и память" : root.page == "general" ? "Общие" : root.page == "about" ? "О программе" : "Настройки";
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }

    flick := Flickable {
        y: 56px;
        width: parent.width;
        height: parent.height - 56px;
        content-height: body.preferred-height;
        interactive: false;
        TouchArea {
            width: parent.width;
            height: max(body.preferred-height, flick.height);
            scroll-event(event) => {
                flick.content-y = max(min(0px, flick.height - body.preferred-height), min(0px, flick.content-y + event.delta-y));
                accept
            }
        }
        body := VerticalLayout {
            width: parent.width;
            padding: 12px;
            spacing: 12px;

            // ---- Main page: profile, then the sections
            if root.page == "main": VerticalLayout {
                spacing: 4px;
                padding-top: 8px;
                padding-bottom: 8px;
                HorizontalLayout {
                    alignment: center;
                    Avatar {
                        size: 96px;
                        initial: root.initial;
                        tint: root.tint;
                        photo: root.photo;
                        has-photo: root.has-photo;
                    }
                }

                Rectangle {
                    height: 6px;
                }

                Text {
                    text: root.name;
                    color: Theme.text;
                    font-size: 19px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: "в сети";
                    color: Theme.accent;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }

            if root.page == "main" && (root.phone != "" || root.username != ""): SettingsCard {
                if root.phone != "": InfoRow {
                    value: root.phone;
                    label: "Телефон";
                    tint: #4cb05e;
                    icon: "M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z";
                }
                if root.username != "": InfoRow {
                    value: root.username;
                    label: "Имя пользователя";
                    tint: #3d8fd9;
                    icon: "M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0zM16 12v1.5a2.5 2.5 0 0 0 5 0V12a9 9 0 1 0-3.5 7.1";
                }
            }

            if root.page == "main": SettingsCard {
                SettingsRow {
                    label: "Уведомления";
                    tint: #e5534b;
                    icon: "M6 16V11a6 6 0 0 1 12 0v5l2 2H4l2-2zM10 20a2 2 0 0 0 4 0";
                    clicked => {
                        root.page = "notifications";
                    }
                }

                SettingsRow {
                    label: "Данные и память";
                    value: root.cache-text;
                    tint: #4cb05e;
                    icon: "M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zM4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3";
                    clicked => {
                        root.page = "data";
                    }
                }

                SettingsRow {
                    label: "Общие";
                    tint: #6f8295;
                    icon: "M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1";
                    clicked => {
                        root.page = "general";
                    }
                }

                SettingsRow {
                    label: "Прокси";
                    value: root.proxy-summary;
                    tint: #3d8fd9;
                    icon: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9M12 3C9.5 5.5 8.2 8.5 8.2 12s1.3 6.5 3.8 9";
                    clicked => {
                        root.open-proxy();
                    }
                }

                SettingsRow {
                    label: "О программе";
                    value: root.version;
                    tint: #8e6bd8;
                    icon: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 11v6M12 7.5v.5";
                    clicked => {
                        root.page = "about";
                    }
                }
            }

            if root.page == "main": SettingsCard {
                SettingsRow {
                    label: "Выйти из аккаунта";
                    danger: true;
                    tint: #e5534b;
                    icon: "M10 4H5v16h5M14 8l4 4-4 4M18 12H9";
                    clicked => {
                        root.sign-out();
                    }
                }
            }

            // ---- Toggle pages: the options of this group
            if root.page == "notifications" || root.page == "data" || root.page == "general": SettingsCard {
                for option in root.options: ToggleRow {
                    visible: option.group == root.page;
                    height: option.group == root.page ? self.preferred-height : 0;
                    option: option;
                    toggle(key) => {
                        root.toggle(key);
                    }
                }
            }

            if root.page == "data": SettingsCard {
                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    height: 64px;
                    Text {
                        text: "Кэш медиа: " + root.cache-text;
                        color: Theme.text;
                        font-size: 15px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Button {
                        kind: "ghost";
                        text: "Очистить";
                        width: 110px;
                        clicked => {
                            root.clear-cache();
                        }
                    }
                }
            }

            if root.page == "about": SettingsCard {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: "Oxigram " + root.version;
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 600;
                        height: 22px;
                    }

                    Text {
                        text: "Лёгкий клиент Telegram на Rust.";
                        color: Theme.dim;
                        font-size: 14px;
                        height: 20px;
                    }

                    Text {
                        text: "Ключи API свои, хранятся только на этом компьютере. Сменить их можно после выхода из аккаунта.";
                        color: Theme.dim;
                        font-size: 14px;
                        wrap: word-wrap;
                        height: 60px;
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> window-title: "Oxigram";
    title: root.window-title;
    icon: @image-url("../../src-tauri/icons/32x32.png");
    preferred-width: 960px;
    preferred-height: 680px;
    min-width: 640px;
    min-height: 480px;
    background: Theme.bg;
    default-font-family: "Open Sans";
    default-font-size: 15px;

    // Login
    in property <string> stage: "loading";
    in property <string> login-phone;
    in property <string> login-hint;
    in property <string> error;
    in property <bool> busy;
    in property <bool> keys-rejected;
    callback save-keys(string, string);
    callback request-code(string);
    callback submit-code(string);
    callback submit-password(string);
    callback back-to-phone();
    callback change-keys();

    // Dialog list
    in property <[DialogItem]> dialogs;
    in property <bool> online: true;
    in property <bool> show-archive;
    in property <int> archived-count;
    in property <string> archived-label;
    callback open-chat(int);
    callback filter-dialogs(string);
    callback load-more-dialogs();
    callback toggle-archive();
    // A row became visible and wants its photo.
    callback want-avatar(int);

    // Open chat
    in property <bool> chat-open;
    in property <string> chat-title;
    in property <string> chat-initial;
    in property <color> chat-color;
    in property <image> chat-photo;
    in property <bool> chat-has-photo;
    in property <bool> chat-saved;
    in property <string> chat-subtitle;
    in property <bool> chat-subtitle-accent;
    in property <string> chat-error;
    in property <[MessageItem]> messages;
    in property <bool> history-loading;
    in-out property <bool> stick-bottom: true;
    callback load-older();
    callback send-text(string);
    // False in a channel the user cannot post in: no composer, a mute switch.
    in property <bool> chat-can-post: true;
    // The one message whose text is selectable right now (see MessageView).
    in-out property <int> selecting-id: -1;
    in property <bool> chat-muted;
    callback toggle-mute();

    // Context menus
    callback dialog-menu(int, length, length);
    callback message-menu(int, length, length);
    in property <[MenuEntry]> menu-items;
    in-out property <bool> menu-open;
    in property <length> menu-x;
    in property <length> menu-y;
    callback menu-pick(string);
    // Quick reactions on top of a message's menu, the own one marked
    in property <[string]> menu-reactions;
    in property <string> menu-reaction-mine;
    callback menu-react(string);
    callback react(int, string);
    callback want-emoji(string);
    // The widest bubble changed (window resized): reaction rows rewrap.
    callback reaction-width(length);

    // Reply / edit bar above the composer: mode "", "reply" or "edit"
    in property <string> bar-mode;
    in property <string> bar-title;
    in property <string> bar-text;
    callback bar-cancel();

    // Burger menu
    in-out property <bool> drawer-open;
    in property <string> me-name;
    in property <string> me-phone;
    in property <string> me-initial;
    in property <color> me-color;
    in property <image> me-photo;
    in property <bool> me-has-photo;
    in property <string> version;
    callback open-saved();
    callback reload-dialogs();
    callback open-settings();

    // Memory saver
    in property <[SaverOption]> saver-options;
    in-out property <bool> saver-open;
    callback open-saver();
    callback saver-toggle(string);

    // Settings
    in-out property <bool> settings-open;
    // "main", "notifications", "data", "general" or "about"
    in-out property <string> settings-page: "main";
    in property <string> me-username;
    in property <string> me-account;
    in property <string> cache-text;
    callback clear-cache();
    callback ask-sign-out();

    // Confirmation for destructive actions
    in-out property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-ok;
    // A checkbox ("Удалить также у собеседника"), hidden when empty
    in property <string> confirm-check;
    in-out property <bool> confirm-checked;
    callback confirm-done(bool);

    // Forward picker
    in-out property <bool> forward-open;
    in property <[DialogItem]> forward-items;
    callback forward-filter(string);
    callback forward-pick(int);

    // A short note at the bottom ("Текст скопирован")
    in property <string> toast;

    // Sending files (native/src/sending.rs): the clip, the send window, the
    // progress pill and the drop hint.
    callback attach();
    callback send-remove(int);
    callback send-go(string, bool);
    callback send-cancel();
    callback send-abort();
    // True when the clipboard held pictures or files, which are now staged.
    callback paste-files() -> bool;
    in-out property <bool> send-open;
    in property <[SendItem]> send-items;
    // "2 файла" and whether the single file is a picture, for the title
    in property <string> send-count-text;
    in property <int> send-count;
    in property <bool> send-single-picture;
    in property <bool> send-has-pictures;
    in-out property <bool> send-compress: true;
    in property <bool> sending-active;
    in property <string> sending-text;
    in property <float> sending-progress;
    in property <bool> drop-hover;

    // Copies through a hidden text field: Slint has no clipboard API.
    public function copy-text(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
        clipboard.text = "";
    }
    public function focus-composer() {
        composer.focus();
    }

    // Rust clears the composer after a send; on failure the text comes back.
    public function set-composer(text: string) {
        composer.text = text;
    }
    // To the end of the estimated content. The ListView estimates the total
    // height from the rows it has measured, so the estimate settles over a
    // few frames; the content-height handler below repeats this while the
    // view sticks to the bottom. (Seeking far past the end can leave only the
    // last row drawn, at the top.)
    public function scroll-to-bottom() {
        root.stick-bottom = true;
        root.settle-frames = 60;
        root.stable-frames = 0;
        history.content-y = min(0px, history.visible-height - history.content-height);
    }
    // Frames left in which the bottom is re-applied while the ListView's
    // height estimate settles. Only after an explicit scroll to the bottom:
    // re-applying it on every estimate change fought the user's own
    // scrolling and made the list jerk.
    // It stops once the estimate has held for three ticks (at most ~1 s):
    // tall channel posts take a while to be measured.
    // Slint scrolls a whole wheel notch in one frame, which reads as jerky.
    // Each notch adds to the distance still to go, and every rendered frame
    // covers a share of it that depends on the frame time (half of it every
    // 35 ms). Spinning the wheel keeps the motion going without the stops
    // ("steps") that restarting an ease-out animation per notch produced.
    // Relative steps, not a target position: the ListView re-anchors its
    // content-y while it measures rows, and a fixed target would fight that.
    property <length> wheel-pending;
    property <duration> wheel-last;
    // Reading animation-tick() makes this change on every frame, but only
    // while there is distance left; otherwise the window stays idle.
    property <duration> wheel-clock: abs(root.wheel-pending) > 0.5px ? animation-tick() : 0ms;
    public function smooth-scroll(dy: length) {
        root.settle-frames = 0;
        root.wheel-pending += dy;
    }
    changed wheel-clock => {
        if (root.wheel-clock == 0ms) {
            root.wheel-last = 0ms;
        } else {
            let dt = root.wheel-last == 0ms ? 16ms : max(1ms, min(50ms, root.wheel-clock - root.wheel-last));
            root.wheel-last = root.wheel-clock;
            let share = 1 - pow(0.5, (dt / 1ms) / 35);
            let step = abs(root.wheel-pending) < 1px ? root.wheel-pending : root.wheel-pending * share;
            let lowest = min(0px, history.visible-height - history.content-height);
            let wanted = history.content-y + step;
            history.content-y = max(lowest, min(0px, wanted));
            // At an end the rest of the motion is dropped. Only a real end:
            // the list also shifts content-y itself when a row with a big
            // picture turns out taller than its estimate.
            root.wheel-pending = wanted > 0px || wanted < lowest ? 0px : root.wheel-pending - step;
        }
    }

    // OXIGRAM_BENCH: scrolls the open chat up by itself, to measure the
    // frame rate of scrolling (with SLINT_DEBUG_PERFORMANCE).
    in property <bool> bench;
    Timer {
        interval: 16ms;
        running: root.bench && root.chat-open;
        triggered => {
            history.content-y = history.content-y + 8px;
        }
    }
    property <int> settle-frames;
    property <int> stable-frames;
    property <length> settled-height;
    settle := Timer {
        interval: 16ms;
        running: root.settle-frames > 0;
        triggered => {
            if (abs(history.content-height - root.settled-height) < 1px) {
                root.stable-frames += 1;
            } else {
                root.stable-frames = 0;
                root.settled-height = history.content-height;
            }
            history.content-y = min(0px, history.visible-height - history.content-height);
            root.settle-frames = root.stable-frames >= 3 ? 0 : root.settle-frames - 1;
        }
    }

    callback close-chat();

    // Proxy window
    callback open-proxy();
    callback proxy-check();
    callback proxy-save();
    in-out property <bool> proxy-open;
    in-out property <bool> proxy-enabled;
    in-out property <string> proxy-kind: "socks5";
    in-out property <string> proxy-host;
    in-out property <string> proxy-port;
    in-out property <string> proxy-user;
    in-out property <string> proxy-pass;
    in property <string> proxy-status;
    in property <bool> proxy-status-ok;
    in property <bool> proxy-busy;
    // "Выключен" / "SOCKS5 · host:port", in the settings
    in property <string> proxy-summary: "Выключен";

    // Pictures and the full-window viewer
    callback want-picture(int);
    callback open-picture(int);
    callback viewer-close();
    callback viewer-save();
    callback viewer-menu(length, length);
    // Video in the viewer
    in property <bool> viewer-video;
    in property <bool> viewer-playing;
    in-out property <bool> viewer-muted;
    in property <float> viewer-progress;
    in property <string> viewer-time;
    callback viewer-toggle-play();
    callback viewer-seek(float);
    callback viewer-toggle-mute();
    // Esc must reach the window's key handler even when a text field had focus.
    public function focus-keys() {
        keys.focus();
    }
    in property <bool> viewer-open;
    in property <image> viewer-image;
    in property <bool> viewer-has-image;
    // "Загрузка…", "1,2 МБ из 3 МБ", or an error
    in property <string> viewer-status;
    // "Сохранить" / "Показать в папке"; empty hides the button
    in property <string> viewer-save-text;

    // Esc peels one layer at a time, as in Telegram Desktop: an open menu or
    // dialog, the reply/edit strip, then the open chat.
    forward-focus: keys;
    keys := FocusScope {
        width: root.width;
        height: root.height;
        capture-key-pressed(event) => {
            // Space pauses a video in the viewer.
            if (event.text == " " && root.viewer-open && root.viewer-video) {
                root.viewer-toggle-play();
                return accept;
            }
            // Ctrl+V of pictures or files from the clipboard (text pastes as usual).
            if ((event.text == "v" || event.text == "V") && (event.modifiers.control || event.modifiers.meta) && root.paste-files()) {
                return accept;
            }
            if (event.text != Key.Escape) {
                return reject;
            }
            if (root.menu-open) {
                root.menu-open = false;
            } else if (root.send-open) {
                root.send-cancel();
            } else if (root.viewer-open && root.viewer-video && event.text == " ") {
                root.viewer-toggle-play();
            } else if (root.viewer-open) {
                root.viewer-close();
            } else if (root.proxy-open) {
                root.proxy-open = false;
            } else if (root.confirm-open) {
                root.confirm-done(false);
            } else if (root.forward-open) {
                root.forward-open = false;
            } else if (root.settings-open && root.settings-page != "main") {
                root.settings-page = "main";
            } else if (root.settings-open) {
                root.settings-open = false;
            } else if (root.drawer-open) {
                root.drawer-open = false;
            } else if (root.bar-mode != "") {
                root.bar-cancel();
            } else if (root.chat-open) {
                root.close-chat();
            } else {
                return reject;
            }
            accept
        }

    if root.stage != "ready": LoginCard {
        stage: root.stage;
        phone: root.login-phone;
        hint: root.login-hint;
        error: root.error;
        busy: root.busy;
        keys-rejected: root.keys-rejected;
        save-keys(id, hash) => {
            root.save-keys(id, hash);
        }
        request-code(phone) => {
            root.request-code(phone);
        }
        submit-code(code) => {
            root.submit-code(code);
        }
        submit-password(password) => {
            root.submit-password(password);
        }
        back-to-phone => {
            root.back-to-phone();
        }
        change-keys => {
            root.change-keys();
        }
        open-proxy => {
            root.open-proxy();
        }
    }

    HorizontalLayout {
        visible: root.stage == "ready";

        // ---- Left pane: search and chats
        Rectangle {
            width: 340px;
            background: Theme.raised;
            VerticalLayout {
                HorizontalLayout {
                    height: 52px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: stretch;
                    if !root.show-archive: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 18px;
                            background: burger-touch.has-hover ? Theme.hover : transparent;
                            burger-touch := TouchArea {
                                clicked => {
                                    root.drawer-open = true;
                                }
                            }
                            StrokeIcon {
                                stroke-width: 2px;
                                commands: "M4 7h16M4 12h16M4 17h16";
                            }
                        }
                    }
                    if root.show-archive: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 18px;
                            background: back-touch.has-hover ? Theme.hover : transparent;
                            back-touch := TouchArea {
                                clicked => {
                                    root.toggle-archive();
                                }
                            }
                            StrokeIcon {
                                stroke-width: 2px;
                                commands: "M15 5l-7 7 7 7";
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 34px;
                            border-radius: 17px;
                            background: Theme.input;
                            border-width: 1px;
                            border-color: search.has-focus ? Theme.accent : transparent;
                            if search.text == "": Text {
                                x: 14px;
                                height: parent.height;
                                text: root.show-archive ? "Поиск в архиве" : "Поиск";
                                color: Theme.dim;
                                vertical-alignment: center;
                            }
                            search := TextInput {
                                x: 14px;
                                width: parent.width - 28px;
                                height: parent.height;
                                vertical-alignment: center;
                                single-line: true;
                                color: Theme.text;
                                selection-background-color: #4a7bb7;
                                edited => {
                                    root.filter-dialogs(self.text);
                                }
                            }
                        }
                    }
                }

                if !root.online: Rectangle {
                    background: #4a3a17;
                    height: 26px;
                    Text {
                        text: "Нет соединения, переподключение…";
                        color: #f1d38a;
                        font-size: 12px;
                    }
                }
                if root.archived-count > 0 && !root.show-archive && search.text == "": ArchiveRow {
                    label: root.archived-label;
                    clicked => {
                        root.toggle-archive();
                    }
                }
                dialog-list := ListView {
                    for item[index] in root.dialogs: DialogRow {
                        item: item;
                        init => {
                            if (!item.has-photo) {
                                root.want-avatar(index);
                            }
                        }
                        clicked => {
                            root.open-chat(index);
                        }
                        context(x, y) => {
                            root.dialog-menu(index, x, y);
                        }
                    }
                    changed content-y => {
                        if (-self.content-y + self.visible-height > self.content-height - 400px) {
                            root.load-more-dialogs();
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        // ---- Right pane: the open chat
        Rectangle {
            horizontal-stretch: 1;
            background: @linear-gradient(180deg, #0e1621 0%, #0b121a 100%);
            clip: true;
            // No radial glows as in the WebView's --chat-bg: the software
            // renderer computes gradients per pixel on every frame, and the two
            // glows alone pushed a scrolling frame from under 16 ms to ~20 ms.
            Image {
                width: parent.width;
                height: parent.height;
                source: @image-url("pattern.svg");
                horizontal-tiling: repeat;
                vertical-tiling: repeat;
            }

            if !root.chat-open: VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Pill {
                        text: "Выберите чат";
                    }
                }
            }
            VerticalLayout {
                visible: root.chat-open;
                Rectangle {
                    height: 52px;
                    background: Theme.raised;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Avatar {
                                size: 36px;
                                initial: root.chat-initial;
                                tint: root.chat-color;
                                photo: root.chat-photo;
                                has-photo: root.chat-has-photo;
                                saved: root.chat-saved;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.chat-title;
                                color: Theme.text;
                                font-weight: 600;
                                font-size: 15px;
                                overflow: elide;
                            }

                            if root.chat-subtitle != "" || root.chat-error != "": Text {
                                text: root.chat-error != "" ? root.chat-error : root.chat-subtitle;
                                color: root.chat-error != "" ? Theme.danger : root.chat-subtitle-accent ? Theme.accent : Theme.dim;
                                font-size: 13px;
                                overflow: elide;
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    // Virtualized: only the bubbles on screen (plus a margin)
                    // exist, however much history is loaded. Heights vary, so
                    // the ListView estimates the total from the average row.
                    history := ListView {
                        // A short chat sits at the bottom, as in Telegram. The
                        // lift is assigned in the handlers below rather than
                        // bound, since the content height depends on the
                        // list's own height.
                        property <length> lift;
                        property <length> room: parent.height;
                        y: self.lift;
                        width: parent.width;
                        height: self.room - self.lift;
                        // An empty list is never lifted: at zero height it would
                        // create no rows and stay empty.
                        changed content-height => {
                            self.lift = self.content-height > 0 ? max(0px, self.room - self.content-height) : 0;
                        }
                        changed room => {
                            self.lift = self.content-height > 0 ? max(0px, self.room - self.content-height) : 0;
                            if (root.stick-bottom) {
                                root.scroll-to-bottom();
                            }
                        }
                        changed content-y => {
                            root.stick-bottom = self.content-y <= self.visible-height - self.content-height + 24px;
                            // Older pages are asked for a screen and a half ahead,
                            // so rows land above the visible ones and the view
                            // keeps its place.
                            if (self.content-y > -1.5 * self.visible-height && !root.history-loading) {
                                root.load-older();
                            }
                        }
                        // On a wide window the conversation stays a readable
                        // column in the middle, as in Telegram Desktop.
                        property <length> column-width: min(Theme.column, self.visible-width);
                        // The widest bubble; Rust wraps reaction chips to it.
                        property <length> bubble-max: min(520px, (self.column-width - 32px) * 0.74);
                        init => {
                            root.reaction-width(self.bubble-max);
                        }
                        changed bubble-max => {
                            root.reaction-width(self.bubble-max);
                        }
                        property <length> side: (self.visible-width - self.column-width) / 2 + 16px;
                        for m[index] in root.messages: Rectangle {
                            height: row.preferred-height;
                            // The wheel over a row scrolls smoothly (see smooth-scroll).
                            TouchArea {
                                scroll-event(event) => {
                                    root.smooth-scroll(event.delta-y);
                                    accept
                                }
                            }
                            row := HorizontalLayout {
                                width: parent.width;
                                padding-left: history.side;
                                padding-right: history.side;
                                padding-top: index == 0 ? 10px : 0;
                                padding-bottom: index == root.messages.length - 1 ? 12px : 0;
                                MessageView {
                                    m: m;
                                    max-bubble: min(520px, (history.column-width - 32px) * 0.74);
                                    context(x, y) => {
                                        root.message-menu(m.id, x, y);
                                    }
                                    wheel(dy) => {
                                        root.smooth-scroll(dy);
                                    }
                                    selecting: root.selecting-id == m.id;
                                    stop-select => {
                                        root.selecting-id = -1;
                                    }
                                    want-picture(id) => {
                                        root.want-picture(id);
                                    }
                                    open-picture(id) => {
                                        root.open-picture(id);
                                    }
                                    react(message, key) => {
                                        root.react(message, key);
                                    }
                                    want-emoji(id) => {
                                        root.want-emoji(id);
                                    }
                                }
                            }
                        }
                    }

                    if !root.stick-bottom: Rectangle {
                        x: parent.width - 56px;
                        y: parent.height - 52px;
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: down-touch.has-hover ? Theme.hover : Theme.raised;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: #00000060;
                        down-touch := TouchArea {
                            clicked => {
                                root.scroll-to-bottom();
                            }
                        }
                        StrokeIcon {
                            stroke-width: 2px;
                            commands: "M6 9l6 6 6-6";
                        }
                    }
                }

                // A channel the user cannot post in: a mute switch, as in Telegram.
                if !root.chat-can-post: Rectangle {
                    height: 48px;
                    background: mute-touch.has-hover ? Theme.hover : Theme.raised;
                    mute-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.toggle-mute();
                        }
                    }
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.border;
                    }

                    Text {
                        text: root.chat-muted ? "Включить звук" : "Выключить звук";
                        color: Theme.accent;
                        font-weight: 600;
                    }
                }

                // Composer: Enter sends, Shift+Enter starts a new line.
                Rectangle {
                    background: Theme.raised;
                    // Lined up with the message column above. Placed with x and
                    // width (not padding) so the window's minimum size does not
                    // depend on its own width.
                    property <length> side: max(12px, (self.width - Theme.column) / 2 + 16px);
                    // Hidden, not removed: functions above reach the composer.
                    visible: root.chat-can-post;
                    height: root.chat-can-post ? bar.preferred-height + self.strip : 0;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.border;
                    }

                    // Reply or edit in progress: a strip above the input.
                    property <length> strip: root.bar-mode != "" ? 46px : 0;
                    if root.bar-mode != "": Rectangle {
                        x: parent.side;
                        y: 4px;
                        width: parent.width - 2 * parent.side;
                        height: 42px;
                        HorizontalLayout {
                            spacing: 10px;
                            padding-left: 4px;
                            VerticalLayout {
                                alignment: center;
                                StrokeIcon {
                                    tint: Theme.accent;
                                    commands: root.bar-mode == "edit" ? "M4 20h4L19 9l-4-4L4 16v4zM14 6l4 4" : "M10 9V5l-7 7 7 7v-4.1c5 0 8.5 1.6 11 5.1-1-5-4-10-11-11z";
                                }
                            }

                            Rectangle {
                                width: 2px;
                                background: Theme.accent;
                            }

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.bar-title;
                                    color: Theme.accent;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.bar-text;
                                    color: Theme.dim;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                            }

                            Rectangle {
                                width: 34px;
                                border-radius: 17px;
                                background: bar-x.has-hover ? Theme.hover : transparent;
                                bar-x := TouchArea {
                                    clicked => {
                                        root.bar-cancel();
                                    }
                                }
                                StrokeIcon {
                                    size: 18px;
                                    stroke-width: 2px;
                                    commands: "M6 6l12 12M18 6L6 18";
                                }
                            }
                        }
                    }

                    bar := HorizontalLayout {
                        x: parent.side;
                        y: parent.strip;
                        width: parent.width - 2 * parent.side;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        alignment: stretch;
                        VerticalLayout {
                            alignment: end;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: clip-touch.has-hover && root.bar-mode != "edit" ? Theme.hover : transparent;
                                opacity: root.bar-mode == "edit" ? 0.4 : 1;
                                clip-touch := TouchArea {
                                    enabled: root.bar-mode != "edit";
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.attach();
                                    }
                                }
                                Icon {
                                    x: 8px;
                                    y: 8px;
                                    size: 24px;
                                    commands: "M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5a2.5 2.5 0 0 1 5 0v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5a2.5 2.5 0 0 0 5 0V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z";
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: max(40px, min(140px, composer.preferred-height + 20px));
                            border-radius: 20px;
                            background: Theme.input;
                            border-width: 1px;
                            border-color: composer.has-focus ? Theme.accent : transparent;
                            if composer.text == "": Text {
                                x: 14px;
                                y: 10px;
                                text: "Сообщение";
                                color: Theme.dim;
                            }
                            FocusScope {
                                x: 14px;
                                y: 10px;
                                width: parent.width - 28px;
                                height: parent.height - 20px;
                                capture-key-pressed(event) => {
                                    if (event.text == Key.Return && !event.modifiers.shift) {
                                        root.send-text(composer.text);
                                        return accept;
                                    }
                                    reject
                                }
                                composer := TextInput {
                                    width: parent.width;
                                    height: parent.height;
                                    single-line: false;
                                    wrap: word-wrap;
                                    color: Theme.text;
                                    selection-background-color: #4a7bb7;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: end;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                property <bool> ready: composer.text != "";
                                background: send-touch.has-hover && self.ready ? #74b3ee : Theme.accent;
                                opacity: self.ready ? 1 : 0.5;
                                send-touch := TouchArea {
                                    enabled: parent.ready;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.send-text(composer.text);
                                    }
                                }
                                Icon {
                                    x: 11px;
                                    size: 20px;
                                    tint: Theme.accent-text;
                                    commands: "M3 20.5v-7l10-1.5-10-1.5v-7L22 12 3 20.5z";
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    clipboard := TextInput {
        visible: false;
        width: 0;
        height: 0;
    }

    // ---- Burger menu
    if root.drawer-open: Rectangle {
        background: #00000073;
        TouchArea {
            clicked => {
                root.drawer-open = false;
            }
            scroll-event(event) => {
                accept
            }
        }
    }
    if root.drawer-open: Rectangle {
        x: 0;
        width: 280px;
        height: root.height;
        background: Theme.raised;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000066;
        TouchArea {
            scroll-event(event) => {
                accept
            }
        }
        VerticalLayout {
            VerticalLayout {
                // Only the spacer above the version takes the free height.
                vertical-stretch: 0;
                alignment: start;
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 20px;
                padding-bottom: 14px;
                spacing: 2px;
                Avatar {
                    size: 52px;
                    initial: root.me-initial;
                    tint: root.me-color;
                    photo: root.me-photo;
                    has-photo: root.me-has-photo;
                }

                Rectangle {
                    height: 8px;
                }

                Text {
                    text: root.me-name;
                    color: Theme.text;
                    font-weight: 600;
                    overflow: elide;
                }

                if root.me-phone != "": Text {
                    text: root.me-phone;
                    color: Theme.dim;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            Rectangle {
                height: 6px;
            }

            DrawerItem {
                text: "Избранное";
                clicked => {
                    root.drawer-open = false;
                    root.open-saved();
                }
            }

            DrawerItem {
                text: "Архив";
                clicked => {
                    root.drawer-open = false;
                    root.toggle-archive();
                }
            }

            DrawerItem {
                text: "Обновить список чатов";
                clicked => {
                    root.drawer-open = false;
                    root.reload-dialogs();
                }
            }

            DrawerItem {
                text: "Экономия памяти";
                clicked => {
                    root.drawer-open = false;
                    root.open-saver();
                }
            }

            DrawerItem {
                text: "Настройки";
                clicked => {
                    root.drawer-open = false;
                    root.open-settings();
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }

            HorizontalLayout {
                padding-left: 18px;
                height: 40px;
                Text {
                    text: "Oxigram " + root.version;
                    color: Theme.dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ---- Settings: a column over the chat list, like Telegram Web
    if root.settings-open: SettingsPanel {
        x: 0;
        y: 0;
        width: min(340px, root.width);
        height: root.height;
        page <=> root.settings-page;
        name: root.me-name;
        phone: root.me-phone;
        username: root.me-username;
        initial: root.me-initial;
        tint: root.me-color;
        photo: root.me-photo;
        has-photo: root.me-has-photo;
        options: root.saver-options;
        cache-text: root.cache-text;
        version: root.version;
        proxy-summary: root.proxy-summary;
        close => {
            root.settings-open = false;
        }
        toggle(key) => {
            root.saver-toggle(key);
        }
        clear-cache => {
            root.clear-cache();
        }
        sign-out => {
            root.ask-sign-out();
        }
        open-proxy => {
            root.open-proxy();
        }
    }

    // ---- Proxy
    if root.proxy-open: Modal {
        width: root.width;
        height: root.height;
        title: "Прокси";
        close => {
            root.proxy-open = false;
        }
        // Use the proxy: on/off
        Rectangle {
            height: 24px;
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.proxy-enabled = !root.proxy-enabled;
                }
            }
            HorizontalLayout {
                spacing: 14px;
                Text {
                    text: "Подключаться через прокси";
                    color: Theme.text;
                    font-size: 15px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 34px;
                        height: 18px;
                        border-radius: 9px;
                        background: root.proxy-enabled ? Theme.accent : Theme.input;
                        Rectangle {
                            x: root.proxy-enabled ? parent.width - self.width - 3px : 3px;
                            y: 3px;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: root.proxy-enabled ? white : Theme.dim;
                        }
                    }
                }
            }
        }

        // Type: only SOCKS5 works yet; the others are shown as coming.
        HorizontalLayout {
            spacing: 8px;
            for kind in [
                { id: "socks5", label: "SOCKS5", ready: true },
                { id: "http", label: "HTTP · скоро", ready: false },
                { id: "mtproto", label: "MTProto · скоро", ready: false },
            ]: Rectangle {
                height: 32px;
                horizontal-stretch: 1;
                border-radius: 16px;
                border-width: 1px;
                border-color: root.proxy-kind == kind.id ? Theme.accent : Theme.border;
                background: root.proxy-kind == kind.id ? #2b527855 : transparent;
                opacity: kind.ready ? 1 : 0.45;
                TouchArea {
                    mouse-cursor: kind.ready ? pointer : default;
                    clicked => {
                        if (kind.ready) {
                            root.proxy-kind = kind.id;
                        }
                    }
                }
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: kind.label;
                    color: Theme.text;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Field {
                horizontal-stretch: 3;
                placeholder: "Адрес, например 127.0.0.1";
                enabled: root.proxy-enabled && !root.proxy-busy;
                text <=> root.proxy-host;
            }

            Field {
                horizontal-stretch: 1;
                placeholder: "Порт";
                enabled: root.proxy-enabled && !root.proxy-busy;
                text <=> root.proxy-port;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Field {
                placeholder: "Логин (если нужен)";
                enabled: root.proxy-enabled && !root.proxy-busy;
                text <=> root.proxy-user;
            }

            Field {
                placeholder: "Пароль";
                password: true;
                enabled: root.proxy-enabled && !root.proxy-busy;
                text <=> root.proxy-pass;
            }
        }

        if root.proxy-status != "": Text {
            text: root.proxy-status;
            color: root.proxy-status-ok ? #6fd388 : Theme.danger;
            font-size: 13px;
            overflow: elide;
            height: 18px;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                kind: "ghost";
                text: "Проверить";
                width: 120px;
                enabled: root.proxy-enabled && !root.proxy-busy;
                clicked => {
                    root.proxy-check();
                }
            }

            Button {
                kind: "ghost";
                text: "Отмена";
                width: 110px;
                clicked => {
                    root.proxy-open = false;
                }
            }

            Button {
                text: "Сохранить";
                width: 120px;
                enabled: !root.proxy-busy;
                clicked => {
                    root.proxy-save();
                }
            }
        }
    }

    // ---- Forward picker
    if root.forward-open: Modal {
        width: root.width;
        height: root.height;
        title: "Переслать в…";
        close => {
            root.forward-open = false;
        }
        Rectangle {
            height: 34px;
            border-radius: 17px;
            background: Theme.input;
            if forward-search.text == "": Text {
                x: 14px;
                height: parent.height;
                text: "Поиск";
                color: Theme.dim;
                vertical-alignment: center;
            }
            forward-search := TextInput {
                x: 14px;
                width: parent.width - 28px;
                height: parent.height;
                vertical-alignment: center;
                single-line: true;
                color: Theme.text;
                init => {
                    self.focus();
                }
                edited => {
                    root.forward-filter(self.text);
                }
            }
        }

        ListView {
            height: min(360px, root.height - 220px);
            for item[index] in root.forward-items: DialogRow {
                item: item;
                clicked => {
                    root.forward-pick(index);
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            Button {
                kind: "ghost";
                text: "Отмена";
                width: 110px;
                clicked => {
                    root.forward-open = false;
                }
            }
        }
    }

    // ---- Confirmation
    if root.confirm-open: Modal {
        width: root.width;
        height: root.height;
        title: root.confirm-title;
        close => {
            root.confirm-done(false);
        }
        Text {
            text: root.confirm-text;
            color: Theme.dim;
            wrap: word-wrap;
        }

        if root.confirm-check != "": Rectangle {
            height: 24px;
            TouchArea {
                clicked => {
                    root.confirm-checked = !root.confirm-checked;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        border-width: 1.5px;
                        border-color: root.confirm-checked ? Theme.accent : Theme.dim;
                        background: root.confirm-checked ? Theme.accent : transparent;
                        if root.confirm-checked: Path {
                            width: 14px;
                            height: 14px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            stroke: Theme.accent-text;
                            stroke-width: 2.5px;
                            commands: "M5 12l5 5 9-10";
                        }
                    }
                }

                Text {
                    text: root.confirm-check;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                kind: "ghost";
                text: "Отмена";
                width: 110px;
                clicked => {
                    root.confirm-done(false);
                }
            }

            DangerButton {
                text: root.confirm-ok;
                clicked => {
                    root.confirm-done(true);
                }
            }
        }
    }

    // ---- Send window (files from the clip, the clipboard or a drop)
    if root.send-open: Modal {
        width: root.width;
        height: root.height;
        title: root.send-count == 1 ? (root.send-single-picture && root.send-compress ? "Отправить фото" : "Отправить файл") : "Отправить " + root.send-count-text;
        close => {
            root.send-cancel();
        }
        // Fixed height: the list scrolls inside, the rest of the window never moves.
        ListView {
            height: min(root.send-items.length * 56px, 224px);
            for item[index] in root.send-items: Rectangle {
                height: 56px;
                HorizontalLayout {
                    spacing: 10px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    Rectangle {
                        width: 48px;
                        border-radius: 8px;
                        background: Theme.input;
                        clip: true;
                        if item.has-thumb: Image {
                            source: item.thumb;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                        }
                        if !item.has-thumb: Icon {
                            x: 12px;
                            y: 12px;
                            size: 24px;
                            commands: "M6 2h8l5 5v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1zm7 1.5V8h4.5L13 3.5z";
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        // One line each: no wrapped text to mis-measure.
                        Text {
                            text: item.name;
                            color: Theme.text;
                            font-size: 14px;
                            overflow: elide;
                            height: 20px;
                        }

                        Text {
                            text: item.size;
                            color: Theme.dim;
                            font-size: 12px;
                            height: 16px;
                        }
                    }

                    Rectangle {
                        width: 32px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 32px;
                                border-radius: 16px;
                                background: remove-touch.has-hover ? Theme.hover : transparent;
                                remove-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.send-remove(index);
                                    }
                                }
                                StrokeIcon {
                                    size: 16px;
                                    stroke-width: 2px;
                                    commands: "M6 6l12 12M18 6L6 18";
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.send-has-pictures: Rectangle {
            height: 24px;
            TouchArea {
                clicked => {
                    root.send-compress = !root.send-compress;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        border-width: 1.5px;
                        border-color: root.send-compress ? Theme.accent : Theme.dim;
                        background: root.send-compress ? Theme.accent : transparent;
                        if root.send-compress: Path {
                            width: 14px;
                            height: 14px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            stroke: Theme.accent-text;
                            stroke-width: 2.5px;
                            commands: "M5 12l5 5 9-10";
                        }
                    }
                }

                Text {
                    text: root.send-count > 1 ? "Сжать изображения" : "Сжать изображение";
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 40px;
            border-radius: 20px;
            background: Theme.input;
            if caption-field.text == "": Text {
                x: 14px;
                height: parent.height;
                text: "Подпись";
                color: Theme.dim;
                vertical-alignment: center;
            }
            caption-field := TextInput {
                x: 14px;
                width: parent.width - 28px;
                height: parent.height;
                vertical-alignment: center;
                single-line: true;
                color: Theme.text;
                selection-background-color: #4a7bb7;
                init => {
                    self.focus();
                }
                accepted => {
                    root.send-go(self.text, root.send-compress);
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                kind: "ghost";
                text: "Добавить";
                width: 104px;
                clicked => {
                    root.attach();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                kind: "ghost";
                text: "Отмена";
                width: 90px;
                clicked => {
                    root.send-cancel();
                }
            }

            Button {
                text: "Отправить";
                width: 110px;
                clicked => {
                    root.send-go(caption-field.text, root.send-compress);
                }
            }
        }
    }

    // ---- Upload progress with a cancel button
    if root.sending-active: Rectangle {
        width: min(360px, root.width - 32px);
        height: 52px;
        x: (root.width - self.width) / 2;
        y: root.height - 160px;
        border-radius: 12px;
        background: #1f2c3af2;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000080;
        Text {
            x: 14px;
            y: 8px;
            width: parent.width - 62px;
            height: 18px;
            text: root.sending-text;
            color: Theme.text;
            font-size: 13px;
            overflow: elide;
        }

        Rectangle {
            x: 14px;
            y: 34px;
            width: parent.width - 62px;
            height: 4px;
            border-radius: 2px;
            background: Theme.input;
            Rectangle {
                x: 0px;
                width: parent.width * max(0.02, min(1.0, root.sending-progress));
                border-radius: 2px;
                background: Theme.accent;
            }
        }

        Rectangle {
            x: parent.width - 44px;
            y: 8px;
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: abort-touch.has-hover ? Theme.hover : transparent;
            abort-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.send-abort();
                }
            }
            StrokeIcon {
                size: 18px;
                stroke-width: 2px;
                commands: "M6 6l12 12M18 6L6 18";
            }
        }
    }

    // ---- Files dragged over the window
    if root.drop-hover: Rectangle {
        background: #0e1621cc;
        Rectangle {
            x: 16px;
            y: 16px;
            width: parent.width - 32px;
            height: parent.height - 32px;
            border-radius: 16px;
            border-width: 2px;
            border-color: Theme.accent;
            Text {
                text: "Отпустите файлы, чтобы отправить";
                color: Theme.text;
                font-size: 18px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // ---- Picture viewer
    if root.viewer-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000e6;
        TouchArea {
            clicked => {
                root.viewer-close();
            }
            pointer-event(event) => {
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                    root.viewer-menu(self.mouse-x, self.mouse-y);
                }
            }
            scroll-event(event) => {
                accept
            }
        }
        if root.viewer-has-image: Image {
            x: 28px;
            y: 56px;
            width: parent.width - 56px;
            height: parent.height - (root.viewer-video ? 128px : 84px);
            source: root.viewer-image;
            image-fit: contain;
        }
        // Video controls: play/pause, time, seek bar, sound.
        if root.viewer-video: Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - 60px;
            width: min(680px, parent.width - 56px);
            height: 44px;
            border-radius: 22px;
            background: #000000b3;
            TouchArea { }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 12px;
                spacing: 10px;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    y: 6px;
                    border-radius: 16px;
                    background: play-touch.has-hover ? #ffffff22 : transparent;
                    play-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.viewer-toggle-play();
                        }
                    }
                    Path {
                        x: 8px;
                        y: 8px;
                        width: 16px;
                        height: 16px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: white;
                        commands: root.viewer-playing ? "M6 4h4v16H6zM14 4h4v16h-4z" : "M7 4l13 8-13 8z";
                    }
                }

                Text {
                    text: root.viewer-time;
                    color: white;
                    font-size: 13px;
                    vertical-alignment: center;
                    min-width: self.preferred-width;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    seek := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.viewer-seek(self.mouse-x / self.width);
                        }
                        moved => {
                            if (self.pressed) {
                                root.viewer-seek(self.mouse-x / self.width);
                            }
                        }
                    }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: seek.has-hover ? 6px : 4px;
                        border-radius: 3px;
                        background: #ffffff40;
                    }
                    Rectangle {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        width: parent.width * root.viewer-progress;
                        height: seek.has-hover ? 6px : 4px;
                        border-radius: 3px;
                        background: white;
                    }
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    y: 6px;
                    border-radius: 16px;
                    background: sound-touch.has-hover ? #ffffff22 : transparent;
                    sound-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.viewer-toggle-mute();
                        }
                    }
                    StrokeIcon {
                        x: 6px;
                        y: 6px;
                        tint: white;
                        commands: root.viewer-muted ? "M11 5 6 9H3v6h3l5 4V5zM16 9l5 6M21 9l-5 6" : "M11 5 6 9H3v6h3l5 4V5zM15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13";
                    }
                }
            }
        }
        if root.viewer-status != "": Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: status-text.preferred-width + 28px;
            height: 34px;
            border-radius: 17px;
            background: #000000a0;
            status-text := Text {
                x: 14px;
                width: self.preferred-width;
                height: parent.height;
                text: root.viewer-status;
                color: white;
                font-size: 14px;
                vertical-alignment: center;
            }
        }
        if root.viewer-save-text != "": Rectangle {
            x: parent.width - 60px - self.width;
            y: 12px;
            width: save-text.preferred-width + 28px;
            height: 36px;
            border-radius: 18px;
            background: save-touch.has-hover ? #ffffff38 : #ffffff22;
            save-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.viewer-save();
                }
            }
            save-text := Text {
                x: 14px;
                width: self.preferred-width;
                height: parent.height;
                text: root.viewer-save-text;
                color: white;
                font-size: 14px;
                vertical-alignment: center;
            }
        }
        Rectangle {
            x: parent.width - 52px;
            y: 10px;
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: close-touch.has-hover ? #ffffff38 : #ffffff22;
            close-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.viewer-close();
                }
            }
            StrokeIcon {
                x: 10px;
                y: 10px;
                tint: white;
                stroke-width: 2px;
                commands: "M6 6l12 12M18 6L6 18";
            }
        }
    }

    // ---- Context menu
    if root.menu-open: TouchArea {
        width: parent.width;
        height: parent.height;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.menu-open = false;
            }
        }
        scroll-event(event) => {
            root.menu-open = false;
            accept
        }
    }
    if root.menu-open: Rectangle {
        width: 220px;
        height: menu-column.preferred-height + 10px;
        x: max(4px, min(root.menu-x, root.width - self.width - 4px));
        y: max(4px, min(root.menu-y, root.height - self.height - 4px));
        background: #1f2c3a;
        border-radius: 10px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000073;
        menu-column := VerticalLayout {
            padding: 5px;
            if root.menu-reactions.length > 0: HorizontalLayout {
                spacing: 1px;
                padding-bottom: 4px;
                for emoji in root.menu-reactions: Rectangle {
                    width: 29px;
                    height: 32px;
                    border-radius: 16px;
                    background: emoji == root.menu-reaction-mine ? #3a6ea5 : quick-touch.has-hover ? #ffffff14 : transparent;
                    quick-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.menu-open = false;
                            root.menu-react(emoji);
                        }
                    }
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: emoji;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            for entry in root.menu-items: Rectangle {
                height: entry.id == "-" ? 9px : 34px;
                if entry.id == "-": Rectangle {
                    y: 4px;
                    height: 1px;
                    background: #ffffff14;
                }
                if entry.id != "-": Rectangle {
                    border-radius: 6px;
                    background: item-touch.has-hover ? #ffffff14 : transparent;
                    item-touch := TouchArea {
                        clicked => {
                            root.menu-open = false;
                            root.menu-pick(entry.id);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 12px;
                        spacing: 10px;
                        alignment: start;
                        Path {
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: entry.icon;
                            fill: transparent;
                            stroke: entry.danger ? Theme.danger : Theme.dim;
                            stroke-width: 1.8px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }

                        Text {
                            text: entry.label;
                            color: entry.danger ? Theme.danger : Theme.text;
                            font-size: 15px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    // ---- Toast
    if root.toast != "": Rectangle {
        y: root.height - 90px;
        x: (root.width - self.width) / 2;
        width: toast-text.preferred-width + 28px;
        height: 34px;
        border-radius: 17px;
        background: #1f2c3aee;
        toast-text := Text {
            text: root.toast;
            color: Theme.text;
            font-size: 14px;
        }
    }
    }
}
